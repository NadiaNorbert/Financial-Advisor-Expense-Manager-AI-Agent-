# ─────────────────────────────────────────────────────────────────────────────
# FinMate AI – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM & AI Advisor / Vision OCR (Google Gemini - Recommended) ─────────────
LLM_PROVIDER=google
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.0-flash

# ── OpenAI (Alternative LLM Provider) ────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Tesseract OCR (Optional: For offline/local OCR on Windows) ────────────────
# Download installer: https://github.com/UB-Mannheim/tesseract/wiki
# Default install path:
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── Splitwise API ────────────────────────────────────────────────────────────
SPLITWISE_CONSUMER_KEY=your_splitwise_consumer_key
SPLITWISE_CONSUMER_SECRET=your_splitwise_consumer_secret
SPLITWISE_API_KEY=your_splitwise_api_key

# ── Database & Storage ───────────────────────────────────────────────────────
DATABASE_PATH=financial_advisor.db

# ── App Settings ─────────────────────────────────────────────────────────────
APP_DEBUG=false
LOG_LEVEL=INFO
