# FinMate AI - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── OpenAI (for AI Advisor — Member 1) ───────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Splitwise API (Member 1) ──────────────────────────────────────
SPLITWISE_CONSUMER_KEY=your_splitwise_consumer_key
SPLITWISE_CONSUMER_SECRET=your_splitwise_consumer_secret
SPLITWISE_API_KEY=your_splitwise_api_key

# ── Database (Member 1) ───────────────────────────────────────────
DATABASE_URL=sqlite:///finmate.db

# ── App settings ─────────────────────────────────────────────────
DEBUG=false
APP_ENV=production

